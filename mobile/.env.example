# PocketBrain Mobile Environment Configuration Template
# Duplicate this file to mobile/.env and customize for your local or production target.
# Pass to Flutter using:
# flutter run --dart-define-from-file=.env
# flutter build web --release --dart-define-from-file=.env

# Remote API Base URL
# Android Emulator local dev: http://10.0.2.2:8000/api/v1
# Desktop / Web local dev:    http://localhost:8000/api/v1
# Production live server:     https://<your-backend-domain>/api/v1
API_BASE_URL="http://10.0.2.2:8000/api/v1"

