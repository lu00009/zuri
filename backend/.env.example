# PocketBrain / Zuri Backend Configuration Example
# Copy this file to .env and provide your deployment-specific secrets.

PROJECT_NAME="PocketBrain API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration
# Local development default: sqlite:///./pocketbrain.db
# Production / Staging: PostgreSQL / Neon connection string (with sslmode=require)
DATABASE_URL="sqlite:///./pocketbrain.db"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Security & Authentication
# Strong 32+ character secret key for JWT signing
SECRET_KEY="replace_with_a_secure_random_32_character_secret_key"
JWT_SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (JSON array or comma-separated URLs)
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:8080","https://proud-maker-453907-b8.web.app"]'

# Google OAuth Configuration
# Web / Android client IDs from Google Cloud Console
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Cloudinary Storage Configuration (Optional, for image uploads)
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="zuri_folders"
